# Pick one or more. `auto` tries them in this order:
# anthropic, xai, openai, google, groq, ollama
LLM_PROVIDER=auto

# --- Anthropic (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5        # or claude-opus-5, claude-haiku-4-5-20251001

# --- xAI (Grok) -------------------------------------------------------------
# NOTE: xAI's "Grok" and the "Groq" inference provider below are different
# companies. XAI_API_KEY is the one for Grok models.
XAI_API_KEY=
# XAI_MODEL=grok-4

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Google (Gemini) --------------------------------------------------------
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-pro

# --- Groq (fast inference of open models) -----------------------------------
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (local, no key) -------------------------------------------------
# OLLAMA_MODEL=llama3.1

# --- Any OpenAI-compatible endpoint: OpenRouter, DeepSeek, Together, vLLM ---
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# --- Ollama tuning ---------------------------------------------------------
# Ollama defaults num_ctx to 4096, which truncates the spine. Raise it.
# OLLAMA_NUM_CTX=16384
# OLLAMA_JSON=1                # native JSON mode; set 0 to disable
# OLLAMA_BASE_URL=http://localhost:11434
